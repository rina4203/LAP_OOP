<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="pattern">%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}" charset="UTF-8"/>
        </Console>
        <File name="File" fileName="logs/tourist-vouchers.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd} ${pattern}" charset="UTF-8"/>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="ua.lab.vouchers" level="debug" additivity="false">
            <AppenderRef ref="Console" level="info"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
